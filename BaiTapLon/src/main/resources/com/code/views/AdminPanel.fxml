<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.code.controllers.AdminPanelController">
    <children>

        <!-- Hình nền -->
        <ImageView pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image>
                <Image url="@../images/screen.jpg" />
            </image>
        </ImageView>

        <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Navbar — giống hệt AuctionList -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color:#065f3b; -fx-padding:10;">
                <Label style="-fx-text-fill:white; -fx-font-size:16; -fx-font-weight:bold;" text="ADMIN PANEL">
                    <font><Font name="Segoe UI Bold" size="16.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblAdminName" style="-fx-text-fill:#c8f5e1; -fx-padding: 0 10 0 0;">
               <font>
                  <Font size="12.0" />
               </font></Label>
                <Button onAction="#handleLogout" style="-fx-background-color: #880000; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 4 13;" text="Đăng xuất">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Button>
            </HBox>

            <!-- Thống kê -->
            <HBox spacing="10" style="-fx-padding:10;">
                <VBox alignment="CENTER" spacing="3" style="-fx-background-color: #003333; -fx-background-radius: 8; -fx-padding: 10 14 10 14; -fx-border-color: #6ee7b7; -fx-border-radius: 8; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:9; -fx-font-weight:bold;" text="TỔNG NGƯỜI DÙNG" />
                    <Label fx:id="lblTotalUsers" style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;">
                        <font><Font name="Segoe UI Bold" size="22.0" /></font>
                    </Label>
                </VBox>
                <VBox alignment="CENTER" spacing="3" style="-fx-background-color: #003333; -fx-background-radius: 8; -fx-padding: 10 14 10 14; -fx-border-color: #6ee7b7; -fx-border-radius: 8; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:9; -fx-font-weight:bold;" text="PHIÊN ĐANG MỞ" textFill="#0f5000" />
                    <Label fx:id="lblActiveSessions" style="-fx-text-fill:#6ee7b7; -fx-font-size:22; -fx-font-weight:bold;">
                        <font><Font name="Segoe UI Bold" size="22.0" /></font>
                    </Label>
                </VBox>
                <VBox alignment="CENTER" spacing="3" style="-fx-background-color: #003333; -fx-background-radius: 8; -fx-padding: 10 14 10 14; -fx-border-color: #6ee7b7; -fx-border-radius: 8; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:9; -fx-font-weight:bold;" text="TỔNG PHIÊN" />
                    <Label fx:id="lblTotalSessions" style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;">
                        <font><Font name="Segoe UI Bold" size="22.0" /></font>
                    </Label>
                </VBox>
                <VBox alignment="CENTER" spacing="3" style="-fx-background-color: #003333; -fx-background-radius: 8; -fx-padding: 10 14 10 14; -fx-border-color: #6ee7b7; -fx-border-radius: 8; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:9; -fx-font-weight:bold;" text="DOANH THU" />
                    <Label fx:id="lblRevenue" style="-fx-text-fill:#6ee7b7; -fx-font-size:22; -fx-font-weight:bold;">
                        <font><Font name="Segoe UI Bold" size="22.0" /></font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Tab buttons — style giống filter buttons AuctionList -->
            <HBox spacing="10" style="-fx-padding:0 10 10 10;">
                <Button fx:id="tabBtnUsers" maxWidth="Infinity" onAction="#switchToUsers" style="-fx-background-color:  #006633; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 7; -fx-cursor: hand; -fx-padding: 6 0 6 0; -fx-font-size: 12;" text="Quản lý người dùng" HBox.hgrow="ALWAYS">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Button>
                <Button fx:id="tabBtnSessions" maxWidth="Infinity" onAction="#switchToSessions" style="-fx-background-color: #006633;                                -fx-text-fill:rgba(255,255,255,0.6);                                -fx-border-color:rgba(255,255,255,0.3);                                -fx-border-radius:7;                                -fx-background-radius:7;                                -fx-cursor:hand;                                -fx-padding:6 0 6 0;                                -fx-font-size:12;" text="Quản lý phiên đấu giá" HBox.hgrow="ALWAYS">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Button>
            </HBox>

            <!-- Panel chính -->
            <StackPane style="-fx-padding:0 10 10 10;" VBox.vgrow="ALWAYS">

                <!-- Panel người dùng -->
                <VBox fx:id="panelUsers" spacing="8" style="-fx-background-color:rgba(255,255,255,0.13);                              -fx-background-radius:10;                              -fx-border-color:#6ee7b7;                              -fx-border-radius:10;                              -fx-border-width:1;                              -fx-padding:10 12 10 12;">

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-text-fill: #003333; -fx-font-size: 11; -fx-font-weight: bold;" text="DANH SÁCH NGƯỜI DÙNG" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="tfUserSearch" onKeyReleased="#handleUserSearch" prefWidth="160" promptText="Tìm theo tên / email..." style="-fx-background-color:rgba(255,255,255,0.9);                                           -fx-text-fill:#1a1a1a;                                           -fx-prompt-text-fill:#999;                                           -fx-background-radius:8;                                           -fx-padding:5 8 5 8;                                           -fx-font-size:11;">
                            <font><Font name="Segoe UI" size="11.0" /></font>
                        </TextField>
                        <ComboBox fx:id="cmbRoleFilter" onAction="#handleUserSearch" prefWidth="120" style="-fx-background-color:rgba(255,255,255,0.9);                                          -fx-background-radius:8;                                          -fx-font-size:11;" />
                        <Button onAction="#handleAddUser" style="-fx-background-color: #006633; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 11; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 5 12 5 12;" text="+ Thêm">
                            <font><Font name="Segoe UI" size="11.0" /></font>
                        </Button>
                    </HBox>

                    <TableView fx:id="tableUsers" style="-fx-background-color: #006633; -fx-control-inner-background: rgba(255,255,255,0.08); -fx-table-cell-border-color: rgba(110,231,183,0.25); -fx-text-fill: white;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colUserId" prefWidth="105.21599560976028" text="ID" />
                     <TableColumn fx:id="colUserName" minWidth="0.0" prefWidth="222.71997833251953" text="username" />
                            <TableColumn fx:id="colUserRole" prefWidth="129.02398681640625" text="Vai trò" />
                            <TableColumn fx:id="colUserStatus" minWidth="0.0" prefWidth="155.13601684570312" text="Trạng thái" />
                            <TableColumn fx:id="colUserAction" prefWidth="778.751953125" text="Hành động" />
                        </columns>
                        <placeholder>
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Chưa có dữ liệu" />
                        </placeholder>
                    </TableView>

                    <Label fx:id="lblUserMsg" style="-fx-text-fill:#fca5a5; -fx-font-size:10;" />
                </VBox>

                <!-- Panel phiên đấu giá -->
                <VBox fx:id="panelSessions" managed="false" spacing="8" style="-fx-background-color:rgba(255,255,255,0.13);                              -fx-background-radius:10;                              -fx-border-color:#6ee7b7;                              -fx-border-radius:10;                              -fx-border-width:1;                              -fx-padding:10 12 10 12;" visible="false">

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label style="-fx-text-fill: #003333;                                       -fx-font-size:11;                                       -fx-font-weight:bold;" text="DANH SÁCH PHIÊN ĐẤU GIÁ" HBox.hgrow="ALWAYS" />
                        <TextField fx:id="tfSessionSearch" onKeyReleased="#handleSessionSearch" prefWidth="160" promptText="Tìm theo sản phẩm..." style="-fx-background-color:rgba(255,255,255,0.9);                                           -fx-text-fill:#1a1a1a;                                           -fx-prompt-text-fill:#999;                                           -fx-background-radius:8;                                           -fx-padding:5 8 5 8;                                           -fx-font-size:11;">
                            <font><Font name="Segoe UI" size="11.0" /></font>
                        </TextField>
                        <ComboBox fx:id="cmbStatusFilter" onAction="#handleSessionSearch" prefWidth="120" style="-fx-background-color:rgba(255,255,255,0.9);                                          -fx-background-radius:8;                                          -fx-font-size:11;" />
                        <Button onAction="#handleCreateSession" style="-fx-background-color: #006633;                                        -fx-text-fill:white;                                        -fx-background-radius:8;                                        -fx-font-size:11;                                        -fx-cursor:hand;            -fx-font-weight:bold;                                        -fx-padding:5 12 5 12;" text="+ Tạo phiên">
                            <font><Font name="Segoe UI" size="11.0" /></font>
                        </Button>
                    </HBox>

                    <TableView fx:id="tableSessions" style="-fx-background-color:transparent;                                       -fx-control-inner-background:rgba(255,255,255,0.08);                                       -fx-table-cell-border-color:rgba(110,231,183,0.25);                                       -fx-text-fill:white;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colSessionId" prefWidth="38" text="ID" />
                            <TableColumn fx:id="colSessionProduct" prefWidth="155" text="Sản phẩm" />
                            <TableColumn fx:id="colSessionStartPrice" prefWidth="105" text="Giá khởi điểm" />
                            <TableColumn fx:id="colSessionCurPrice" prefWidth="105" text="Giá hiện tại" />
                            <TableColumn fx:id="colSessionStatus" prefWidth="80" text="Trạng thái" />
                            <TableColumn fx:id="colSessionAction" prefWidth="100" text="Hành động" />
                        </columns>
                        <placeholder>
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Chưa có dữ liệu" />
                        </placeholder>
                    </TableView>

                    <Label fx:id="lblSessionMsg" style="-fx-text-fill:#fca5a5; -fx-font-size:10;" />
                </VBox>

            </StackPane>
        </VBox>
    </children>
</AnchorPane>
