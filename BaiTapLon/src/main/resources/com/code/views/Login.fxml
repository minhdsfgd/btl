<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
            Layout: StackPane (root)
              Layer 1 — Hình nền (tự co giãn theo cửa sổ)
              Layer 2 — HBox chia đôi màn hình:
                          Trái: Form đăng nhập
                          Phải: Hình minh hoạ
        -->

<StackPane minHeight="500" minWidth="800" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.code.controllers.LoginController">

   <!-- ═══ LAYER 1: Hình nền (luôn phủ đầy cửa sổ) ═══ -->
   <ImageView fitHeight="1080" fitWidth="1920" pickOnBounds="true" preserveRatio="false" StackPane.alignment="CENTER">
      <!-- fitWidth/fitHeight lớn để không bị pixel scale khi zoom;
           StackPane tự clip phần thừa ra ngoài cửa sổ.
           preserveRatio="false" + StackPane fill = cover effect. -->
      <image>
         <Image url="@../images/screen.jpg" />
      </image>
   </ImageView>

   <!-- ═══ LAYER 2: Nội dung ═══ -->
   <HBox alignment="CENTER" spacing="0">

      <!-- ── Nửa trái: Form đăng nhập ── -->
      <VBox alignment="CENTER" maxWidth="520" spacing="18" HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="60" left="50" right="50" top="60" />
         </padding>

         <!-- Tiêu đề -->
         <Label textFill="#003322">
            <font><Font name="System Bold" size="28" /></font>
         </Label>

         <!-- Tên đăng nhập -->
         <VBox fillWidth="true" maxWidth="Infinity" spacing="5">
            <Label text="Tên đăng nhập" textFill="#111111">
               <font><Font size="14" /></font>
            </Label>
            <TextField fx:id="usernameField" maxWidth="Infinity" prefHeight="44" promptText="username" style="-fx-background-color: #c6e8ea;                                   -fx-text-fill: #000080;                                   -fx-border-color: #555555;                                   -fx-border-radius: 6;                                   -fx-background-radius: 6;                                   -fx-padding: 8;                                   -fx-prompt-text-fill: #707070;">
               <font><Font size="13" /></font>
            </TextField>
         </VBox>

         <!-- Mật khẩu -->
         <VBox fillWidth="true" maxWidth="Infinity" spacing="5">
            <Label text="Mật khẩu" textFill="#111111">
               <font><Font size="14" /></font>
            </Label>
            <PasswordField fx:id="passwordField" maxWidth="Infinity" prefHeight="44" promptText="Nhập mật khẩu" style="-fx-background-color: #c6e8ea;                                       -fx-text-fill: #000080;                                       -fx-border-color: #555555;                                       -fx-border-radius: 6;                                       -fx-background-radius: 6;                                       -fx-padding: 8;">
               <font><Font size="13" /></font>
            </PasswordField>
         </VBox>

         <!-- Nút đăng nhập -->
         <Button fx:id="loginButton" maxWidth="175.0" prefHeight="20.0" style="-fx-background-color: #006633;                            -fx-text-fill: #f0f0f0;                            -fx-border-radius: 8;                            -fx-background-radius: 8;                            -fx-cursor: hand;                            -fx-font-size: 15;" text="Đăng nhập">
         </Button>

         <!-- Link đăng ký -->
         <HBox alignment="CENTER" spacing="4">
            <Label text="Chưa có tài khoản?" textFill="#222222">
               <font><Font size="13" /></font>
            </Label>
            <Hyperlink fx:id="linkRegister" text="Đăng ký" textFill="#1b55db">
               <font><Font size="13" /></font>
            </Hyperlink>
         </HBox>
      </VBox>

      <!-- Spacer đẩy hình sang phải -->
      <Region HBox.hgrow="ALWAYS" />

      <!-- ── Nửa phải: Hình minh hoạ ── -->
      <VBox alignment="CENTER" maxWidth="700" HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="40" left="0" right="40" top="40" />
         </padding>
         <ImageView fitHeight="500" fitWidth="600" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../images/loginn.jpg" />
            </image>
         </ImageView>
      </VBox>

   </HBox>
</StackPane>
