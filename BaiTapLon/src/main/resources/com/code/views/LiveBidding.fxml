<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.StackPane?>
<AnchorPane prefHeight="620" prefWidth="1080" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.code.controllers.LiveBiddingController">
    <children>

        <!-- Hình nền -->
        <ImageView pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image><Image url="@../images/screen.jpg" /></image>
        </ImageView>

        <!-- Root VBox: neo 4 cạnh vào AnchorPane → luôn đúng kích thước cửa sổ -->
        <VBox spacing="0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- ═══════════════ NAVBAR ═══════════════ -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#065f3b; -fx-padding:10 16;" VBox.vgrow="NEVER">

                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="sessionNameLabel" style="-fx-text-fill:#c8f5e1; -fx-font-size:10;" />
                </VBox>

                <Label style="-fx-text-fill:white; -fx-font-size:16; -fx-font-weight:bold;" text="ĐẤU GIÁ TRỰC TIẾP">
                    <font><Font name="Segoe UI Bold" size="16.0" /></font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="2" style="-fx-background-color:rgba(255,255,255,0.15);                              -fx-background-radius:20; -fx-padding:3 4;">
                    <Button fx:id="backToListButton" onAction="#handleBackToList" style="-fx-background-color:transparent;                                    -fx-text-fill:rgba(255,255,255,0.8);                                    -fx-font-size:12; -fx-background-radius:16;                                    -fx-padding:4 12; -fx-cursor:hand;" text="← Danh sách phiên" />
                </HBox>

                <HBox alignment="CENTER" spacing="5" style="-fx-background-color:rgba(255,255,255,0.12);                              -fx-background-radius:10; -fx-padding:4 10;">
                    <Label style="-fx-font-size:11;" text="💰" />
                    <Label fx:id="balanceLiveLabel" style="-fx-text-fill:#6ee7b7; -fx-font-weight:bold; -fx-font-size:11;" text="0 ₫" />
                </HBox>

                <Label fx:id="currentUserLabel" style="-fx-text-fill:#c8f5e1; -fx-padding:0 6 0 0;" text="username" />

                <Button onAction="#handleExitRoom" style="-fx-background-color:#880000; -fx-text-fill:white;                                -fx-font-weight:bold; -fx-background-radius:5; -fx-padding:4 13;" text="Thoát phòng">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Button>
            </HBox>

            <!-- ═══════════════ NỘI DUNG CHÍNH ═══════════════
                 VBox.vgrow=ALWAYS → lấp đầy chiều cao còn lại sau navbar
            -->
            <HBox spacing="12" style="-fx-padding:12;" VBox.vgrow="ALWAYS">

                <!-- ╔══════════════════════════════╗
                     ║  CỘT TRÁI                    ║
                     ╚══════════════════════════════╝ -->
                <VBox spacing="10" HBox.hgrow="ALWAYS">

                    <!-- Card Sản phẩm: giãn dọc để lấp phần còn lại cột trái -->
                    <VBox spacing="10" style="-fx-background-color:#003333; -fx-background-radius:10;                                  -fx-border-color:#6ee7b7; -fx-border-radius:10;                                  -fx-border-width:1; -fx-padding:14;" VBox.vgrow="ALWAYS">

                        <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" text="SẢN PHẨM" />

                        <!-- Vùng chứa ảnh: nền tối, cố định chiều cao 180px -->
                        <StackPane prefHeight="180" minHeight="180" maxHeight="180"
                                   style="-fx-background-color:#001a1a;" VBox.vgrow="NEVER">

                            <!-- Khung vuông 160×160: viền xanh, bo góc, ảnh căn giữa không tràn -->
                            <StackPane prefWidth="160" prefHeight="160"
                                       minWidth="160"  minHeight="160"
                                       maxWidth="160"  maxHeight="160"
                                       style="-fx-background-color:#001a1a;
                      -fx-border-color:#6ee7b7;
                      -fx-border-width:1.5;
                      -fx-border-radius:8;
                      -fx-background-radius:8;">
                                <ImageView fx:id="productImageView"
                                           fitWidth="152" fitHeight="152"
                                           preserveRatio="true"
                                           style="-fx-effect:dropshadow(gaussian,rgba(110,231,183,0.3),6,0,0,0);" />
                            </StackPane>
                        </StackPane>

                        <Label fx:id="productNameLabel" style="-fx-text-fill:white; -fx-font-size:14; -fx-font-weight:bold;" text="—" wrapText="true" VBox.vgrow="NEVER">
                            <font><Font name="Segoe UI Bold" size="14.0" /></font>
                        </Label>

                        <Label fx:id="productDescLabel" style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Chưa có mô tả" wrapText="true" VBox.vgrow="NEVER" />

                        <Label fx:id="productCategoryLabel" style="-fx-background-color:rgba(110,231,183,0.2);                                       -fx-text-fill:#6ee7b7; -fx-font-size:10;                                       -fx-background-radius:6; -fx-padding:3 10;" text="Danh mục" VBox.vgrow="NEVER" />
                    </VBox>

                    <!-- Card Giá: không giãn dọc -->
                    <VBox spacing="6" style="-fx-background-color:#003333; -fx-background-radius:10;                                  -fx-border-color:#6ee7b7; -fx-border-radius:10;                                  -fx-border-width:1; -fx-padding:14;" VBox.vgrow="NEVER">
                        <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" text="GIÁ HIỆN TẠI" />
                        <Label fx:id="currentPriceLabel" style="-fx-text-fill:#6ee7b7; -fx-font-size:22; -fx-font-weight:bold;" text="—">
                            <font><Font name="Segoe UI Bold" size="22.0" /></font>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Dẫn đầu:" />
                            <Label fx:id="leadingBidderLabel" style="-fx-text-fill:white; -fx-font-size:11; -fx-font-weight:bold;" text="—" wrapText="true" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Khởi điểm:" />
                            <Label fx:id="startPriceLabel" style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="—" />
                        </HBox>
                    </VBox>

                    <!-- Card Đếm ngược: không giãn dọc -->
                    <VBox spacing="6" style="-fx-background-color:#003333; -fx-background-radius:10;                                  -fx-border-color:#6ee7b7; -fx-border-radius:10;                                  -fx-border-width:1; -fx-padding:14;" VBox.vgrow="NEVER">
                        <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" text="THỜI GIAN CÒN LẠI" />
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="countdownLabel" style="-fx-text-fill:#6ee7b7; -fx-font-size:24; -fx-font-weight:bold;" text="--:--:--">
                                <font><Font name="Segoe UI Bold" size="24.0" /></font>
                            </Label>
                            <Label fx:id="sessionStatusLabel" style="-fx-background-color:rgba(110,231,183,0.2);                                           -fx-text-fill:white; -fx-font-size:10;                                           -fx-font-weight:bold; -fx-background-radius:6;                                           -fx-padding:3 8;" text="Đang diễn ra" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Kết thúc lúc:" />
                            <Label fx:id="endTimeLabel" style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="—" />
                        </HBox>
                    </VBox>

                </VBox>

                <!-- ╔═══════════════════════════════════════╗
                     ║  CỘT GIỮA                             ║
                     ╚═══════════════════════════════════════╝ -->
                <VBox spacing="10" HBox.hgrow="ALWAYS">

                    <!-- Card đặt giá thủ công: không giãn dọc -->
                    <VBox alignment="CENTER" spacing="12" style="-fx-background-color:#003333; -fx-background-radius:10;                                  -fx-border-color:#6ee7b7; -fx-border-radius:10;                                  -fx-border-width:1; -fx-padding:16;" VBox.vgrow="NEVER">

                        <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" text="ĐẶT GIÁ CỦA BẠN" />

                        <HBox alignment="CENTER" spacing="6">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:12;" text="Bước tối thiểu:" />
                            <Label fx:id="minStepLabel" style="-fx-text-fill:#6ee7b7; -fx-font-size:12; -fx-font-weight:bold;" text="—" />
                        </HBox>

                        <TextField fx:id="bidAmountField" maxWidth="Infinity" onAction="#handlePlaceBid" prefHeight="42.0" promptText="Nhập giá (VND)" style="-fx-background-color:#99D1D3; -fx-text-fill:#1a1a1a;                                           -fx-prompt-text-fill:#000022; -fx-background-radius:8;                                           -fx-font-size:15; -fx-alignment:CENTER; -fx-padding:8 12;">
                            <font><Font name="Segoe UI" size="15.0" /></font>
                        </TextField>

                        <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Đặt nhanh:" />

                        <HBox alignment="CENTER" spacing="8">
                            <Button fx:id="quickBid1" onAction="#handleQuickBid1" prefWidth="80" style="-fx-background-color: rgba(110,231,183,0.12); -fx-text-fill: white; -fx-border-color: #6ee7b7; -fx-border-width: 0.8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12; -fx-padding: 6 0; -fx-cursor: hand;" text="+100k" />
                            <Button fx:id="quickBid2" onAction="#handleQuickBid2" prefWidth="80" style="-fx-background-color: rgba(110,231,183,0.12); -fx-text-fill: white; -fx-border-color: #6ee7b7; -fx-border-width: 0.8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12; -fx-padding: 6 0; -fx-cursor: hand;" text="+500k" />
                            <Button fx:id="quickBid3" onAction="#handleQuickBid3" prefWidth="80" style="-fx-background-color: rgba(110,231,183,0.12); -fx-text-fill: white; -fx-border-color: #6ee7b7; -fx-border-width: 0.8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12; -fx-padding: 6 0; -fx-cursor: hand;" text="+1M" />
                        </HBox>

                        <Label fx:id="errorLabel" maxWidth="Infinity" style="-fx-text-fill:#fca5a5; -fx-font-size:11;" text="" wrapText="true" />

                        <Button maxWidth="Infinity" onAction="#handlePlaceBid" style="-fx-background-color:#770000; -fx-text-fill:white;                                        -fx-font-size:14; -fx-font-weight:bold;                                        -fx-background-radius:8; -fx-cursor:hand; -fx-padding:10 0;" text="ĐẶT GIÁ NGAY">
                            <font><Font name="Segoe UI Bold" size="14.0" /></font>
                        </Button>

                        <HBox alignment="CENTER" spacing="6" style="-fx-background-color:rgba(255,255,255,0.06);                                      -fx-background-radius:8; -fx-padding:8 14;">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Số dư của bạn:" />
                            <Label fx:id="balanceLiveLabel2" style="-fx-text-fill:#6ee7b7; -fx-font-weight:bold; -fx-font-size:12;" text="0 ₫" />
                        </HBox>
                    </VBox>

                    <!-- Card Đấu giá tự động: giãn chiếm phần còn lại -->
                    <VBox spacing="10" style="-fx-background-color:#003333; -fx-background-radius:10;                                  -fx-border-color:#f59e0b; -fx-border-radius:10;                                  -fx-border-width:1; -fx-padding:16;" VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="8" VBox.vgrow="NEVER">
                            <Label style="-fx-font-size:14;" text="🤖" />
                            <Label style="-fx-text-fill:#fbbf24; -fx-font-size:10; -fx-font-weight:bold;" text="ĐẤU GIÁ TỰ ĐỘNG" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="autoBidStatusBadge" style="-fx-background-color:rgba(239,68,68,0.25);                                           -fx-text-fill:#fca5a5; -fx-font-size:9;                                           -fx-font-weight:bold; -fx-background-radius:6;                                           -fx-padding:2 8;" text="TẮT" />
                        </HBox>

                        <Separator style="-fx-background-color:rgba(251,191,36,0.3);" VBox.vgrow="NEVER" />

                        <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:10;" text="Hệ thống tự động đặt giá thay bạn khi có người vượt qua, tối đa đến mức giá trần bạn đặt." wrapText="true" VBox.vgrow="NEVER" />

                        <VBox spacing="4" VBox.vgrow="NEVER">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11; -fx-font-weight:bold;" text="Giá trần tối đa (VND)" />
                            <TextField fx:id="autoBidMaxField" maxWidth="Infinity" promptText="Nhập giá trần tối đa..." style="-fx-background-color:#99D1D3; -fx-text-fill:#1a1a1a;                                               -fx-prompt-text-fill:#000022; -fx-background-radius:8;                                               -fx-font-size:13; -fx-alignment:CENTER; -fx-padding:7 10;">
                                <font><Font name="Segoe UI" size="13.0" /></font>
                            </TextField>
                        </VBox>

                        <VBox spacing="4" VBox.vgrow="NEVER">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11; -fx-font-weight:bold;" text="Bước tăng mỗi lần tự động" />
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Button fx:id="autoStep1" onAction="#handleAutoStep1" prefWidth="78" style="-fx-background-color: rgba(251,191,36,0.15); -fx-text-fill: white; -fx-border-color: white; -fx-border-width: 0.8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 10; -fx-padding: 5 0; -fx-cursor: hand;" text="Tối thiểu" />
                                <Button fx:id="autoStep2" onAction="#handleAutoStep2" prefWidth="78" style="-fx-background-color: rgba(251,191,36,0.15); -fx-text-fill: white; -fx-border-color: white; -fx-border-width: 0.8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 10; -fx-padding: 5 0; -fx-cursor: hand;" text="+500k" />
                                <Button fx:id="autoStep3" onAction="#handleAutoStep3" prefWidth="78" style="-fx-background-color: rgba(251,191,36,0.15); -fx-text-fill: white; -fx-border-color: white; -fx-border-width: 0.8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 10; -fx-padding: 5 0; -fx-cursor: hand;" text="+1M" />
                            </HBox>
                            <TextField fx:id="autoBidStepField" maxWidth="Infinity" promptText="Hoặc nhập bước tùy chỉnh..." style="-fx-background-color:#99D1D3; -fx-text-fill:#1a1a1a;                                               -fx-prompt-text-fill:#000022; -fx-background-radius:8;                                               -fx-font-size:12; -fx-alignment:CENTER; -fx-padding:6 10;">
                                <font><Font name="Segoe UI" size="12.0" /></font>
                            </TextField>
                        </VBox>

                        <VBox spacing="3" style="-fx-background-color:rgba(251,191,36,0.08);                                      -fx-background-radius:8; -fx-padding:8 10;" VBox.vgrow="NEVER">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Giá trần:" />
                                <Label fx:id="autoBidMaxDisplay" style="-fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: bold;" text="Chưa đặt" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Bước tăng:" />
                                <Label fx:id="autoBidStepDisplay" style="-fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: bold;" text="Chưa đặt" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Lần đặt cuối:" />
                                <Label fx:id="autoBidLastBidDisplay" style="-fx-text-fill:white; -fx-font-size:11;" text="—" />
                            </HBox>
                        </VBox>

                        <Label fx:id="autoBidErrorLabel" maxWidth="Infinity" style="-fx-text-fill:#fca5a5; -fx-font-size:10;" text="" wrapText="true" VBox.vgrow="NEVER" />

                        <!-- Spacer đẩy nút xuống đáy card -->
                        <Region VBox.vgrow="ALWAYS" />

                        <Button fx:id="toggleAutoBidButton" maxWidth="Infinity" onAction="#handleToggleAutoBid" style="-fx-background-color: #770000; -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 9 0;" text="⚡ BẬT ĐẤU GIÁ TỰ ĐỘNG" VBox.vgrow="NEVER">
                            <font><Font name="Segoe UI Bold" size="13.0" /></font>
                        </Button>

                    </VBox>
                </VBox>

                <!-- ╔══════════════════════════════════════════╗
                     ║  CỘT PHẢI                                ║
                     ╚══════════════════════════════════════════╝ -->
                <VBox spacing="10" HBox.hgrow="ALWAYS">

                    <!-- Card Biểu đồ: không giãn, chart bị kìm ở maxHeight=prefHeight -->
                    <VBox spacing="8" style="-fx-background-color:#003333; -fx-background-radius:10;                                  -fx-border-color:#6ee7b7; -fx-border-radius:10;                                  -fx-border-width:1; -fx-padding:14;" VBox.vgrow="NEVER">
                        <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" text="BIỂU ĐỒ GIÁ THỜI GIAN THỰC" />

                        <LineChart fx:id="bidChart" animated="false" maxHeight="190" maxWidth="Infinity" prefHeight="190" style="-fx-background-color:transparent; -fx-padding:0;" VBox.vgrow="NEVER">
                            <xAxis>
                                <NumberAxis forceZeroInRange="false" label="Lượt đặt" minorTickCount="0" side="BOTTOM" style="-fx-tick-label-fill:white;" tickUnit="1" fx:id="xAxis" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="yAxis" autoRanging="true" forceZeroInRange="false" label="Giá (VND)" side="LEFT" style="-fx-tick-label-fill:white;" />
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <!-- Card Lịch sử: chiếm toàn bộ còn lại — minHeight=0 tránh ép layout -->
                    <VBox spacing="8" style="-fx-background-color:#003333; -fx-background-radius:10;                                  -fx-border-color:#6ee7b7; -fx-border-radius:10;                                  -fx-border-width:1; -fx-padding:14;" VBox.vgrow="ALWAYS">
                        <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" text="LỊCH SỬ ĐẶT GIÁ" VBox.vgrow="NEVER" />

                        <TableView fx:id="bidHistoryTable" minHeight="0" style="-fx-background-color:transparent;                                           -fx-table-cell-border-color:transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colUsername" prefWidth="196.6080311536789" text="Người đặt" />
                                <TableColumn fx:id="colTime" prefWidth="151.29591369628906" text="Thời gian" />
                                <TableColumn fx:id="colAmount" prefWidth="158.97598266601562" text="Giá đặt (VND)" />
                            </columns>
                            <placeholder>
                                <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Chưa có lượt đặt giá nào" />
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
