<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="620" prefWidth="1080"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.code.controllers.LiveBiddingController">
    <children>

        <!-- Hình nền -->
        <ImageView pickOnBounds="true" preserveRatio="false"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image>
                <Image url="@../images/screen.jpg" />
            </image>
        </ImageView>

        <VBox spacing="0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- ═══════════════ NAVBAR ═══════════════ -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color:#065f3b; -fx-padding:10 16;">

                <VBox alignment="CENTER_LEFT">
                    <Label fx:id="sessionNameLabel"
                           style="-fx-text-fill:#c8f5e1; -fx-font-size:10;" />
                </VBox>

                <Label style="-fx-text-fill:white; -fx-font-size:16; -fx-font-weight:bold;"
                       text="ĐẤU GIÁ TRỰC TIẾP">
                    <font><Font name="Segoe UI Bold" size="16.0" /></font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="2"
                      style="-fx-background-color:rgba(255,255,255,0.15);
                             -fx-background-radius:20; -fx-padding:3 4;">
                    <Button fx:id="backToListButton" onAction="#handleBackToList"
                            style="-fx-background-color:transparent;
                                   -fx-text-fill:rgba(255,255,255,0.8);
                                   -fx-font-size:12; -fx-background-radius:16;
                                   -fx-padding:4 12; -fx-cursor:hand;"
                            text="← Danh sách phiên" />
                </HBox>

                <Label fx:id="currentUserLabel"
                       style="-fx-text-fill:#c8f5e1; -fx-padding:0 6 0 0;"
                       text="username" />

                <HBox alignment="CENTER" spacing="5"
                      style="-fx-background-color:rgba(255,255,255,0.12);
                             -fx-background-radius:10; -fx-padding:4 10;">
                    <Label style="-fx-font-size:11;" text="💰" />
                    <Label fx:id="balanceLiveLabel"
                           style="-fx-text-fill:#6ee7b7; -fx-font-weight:bold; -fx-font-size:11;"
                           text="0 ₫" />
                </HBox>

                <Button onAction="#handleExitRoom"
                        style="-fx-background-color:#880000; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-background-radius:5; -fx-padding:4 13;"
                        text="Thoát phòng">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Button>
            </HBox>

            <!-- ═══════════════════════════════════════════════════════
                 NỘI DUNG CHÍNH: 3 CỘT CÂN BẰNG — mỗi cột HBox.hgrow=ALWAYS
                 ═══════════════════════════════════════════════════════ -->
            <HBox spacing="12" style="-fx-padding:12;" VBox.vgrow="ALWAYS">

                <!-- ╔══════════════════════════════╗
                     ║  CỘT TRÁI — Sản phẩm + Giá  ║
                     ║  + Timer  (1/3 chiều rộng)   ║
                     ╚══════════════════════════════╝ -->
                <VBox spacing="10" HBox.hgrow="ALWAYS">

                    <!-- Card Sản phẩm -->
                    <VBox spacing="10" VBox.vgrow="ALWAYS"
                          style="-fx-background-color:#003333; -fx-background-radius:10;
                                 -fx-border-color:#6ee7b7; -fx-border-radius:10;
                                 -fx-border-width:1; -fx-padding:14;">

                        <Label text="SẢN PHẨM"
                               style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" />

                        <!-- Ảnh sản phẩm căn giữa -->
                        <HBox alignment="CENTER">
                            <ImageView fx:id="productImageView"
                                       fitHeight="140" fitWidth="200"
                                       preserveRatio="true"
                                       style="-fx-effect:dropshadow(gaussian,rgba(110,231,183,0.3),8,0,0,0);" />
                        </HBox>

                        <Label fx:id="productNameLabel"
                               style="-fx-text-fill:white; -fx-font-size:14; -fx-font-weight:bold;"
                               text="—" wrapText="true">
                            <font><Font name="Segoe UI Bold" size="14.0" /></font>
                        </Label>

                        <Label fx:id="productDescLabel"
                               style="-fx-text-fill:#c8f5e1; -fx-font-size:11;"
                               text="Chưa có mô tả" wrapText="true" />

                        <Label fx:id="productCategoryLabel"
                               style="-fx-background-color:rgba(110,231,183,0.2);
                                      -fx-text-fill:#6ee7b7; -fx-font-size:10;
                                      -fx-background-radius:6; -fx-padding:3 10;"
                               text="Danh mục" />
                    </VBox>

                    <!-- Card Giá hiện tại -->
                    <VBox spacing="6"
                          style="-fx-background-color:#003333; -fx-background-radius:10;
                                 -fx-border-color:#6ee7b7; -fx-border-radius:10;
                                 -fx-border-width:1; -fx-padding:14;">
                        <Label text="GIÁ HIỆN TẠI"
                               style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" />
                        <Label fx:id="currentPriceLabel"
                               style="-fx-text-fill:#6ee7b7; -fx-font-size:22; -fx-font-weight:bold;"
                               text="—">
                            <font><Font name="Segoe UI Bold" size="22.0" /></font>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Dẫn đầu:" />
                            <Label fx:id="leadingBidderLabel"
                                   style="-fx-text-fill:white; -fx-font-size:11; -fx-font-weight:bold;"
                                   text="—" wrapText="true" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Khởi điểm:" />
                            <Label fx:id="startPriceLabel"
                                   style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="—" />
                        </HBox>
                    </VBox>

                    <!-- Card Đếm ngược -->
                    <VBox spacing="6"
                          style="-fx-background-color:#003333; -fx-background-radius:10;
                                 -fx-border-color:#6ee7b7; -fx-border-radius:10;
                                 -fx-border-width:1; -fx-padding:14;">
                        <Label text="THỜI GIAN CÒN LẠI"
                               style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" />
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="countdownLabel"
                                   style="-fx-text-fill:#6ee7b7; -fx-font-size:24; -fx-font-weight:bold;"
                                   text="--:--:--">
                                <font><Font name="Segoe UI Bold" size="24.0" /></font>
                            </Label>
                            <Label fx:id="sessionStatusLabel"
                                   style="-fx-background-color:rgba(110,231,183,0.2);
                                          -fx-text-fill:#6ee7b7; -fx-font-size:10;
                                          -fx-font-weight:bold; -fx-background-radius:6;
                                          -fx-padding:3 8;"
                                   text="Đang diễn ra" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Kết thúc lúc:" />
                            <Label fx:id="endTimeLabel"
                                   style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="—" />
                        </HBox>
                    </VBox>

                </VBox>

                <!-- ╔══════════════════════════════════╗
                     ║  CỘT GIỮA — Đặt giá + Nút nhanh ║
                     ║  + Số dư  (1/3 chiều rộng)       ║
                     ╚══════════════════════════════════╝ -->
                <VBox spacing="10" HBox.hgrow="ALWAYS">

                    <VBox alignment="CENTER" spacing="14" VBox.vgrow="ALWAYS"
                          style="-fx-background-color:#003333; -fx-background-radius:10;
                                 -fx-border-color:#6ee7b7; -fx-border-radius:10;
                                 -fx-border-width:1; -fx-padding:20;">

                        <Label text="ĐẶT GIÁ CỦA BẠN"
                               style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" />

                        <HBox alignment="CENTER" spacing="6">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:12;"
                                   text="Bước tối thiểu:" />
                            <Label fx:id="minStepLabel"
                                   style="-fx-text-fill:#6ee7b7; -fx-font-size:12; -fx-font-weight:bold;"
                                   text="—" />
                        </HBox>

                        <!-- Ô nhập giá — full width cột giữa -->
                        <TextField fx:id="bidAmountField"
                                   maxWidth="Infinity" onAction="#handlePlaceBid"
                                   prefHeight="42.0"
                                   promptText="Nhập giá (VND)"
                                   style="-fx-background-color:#99D1D3; -fx-text-fill:#1a1a1a;
                                          -fx-prompt-text-fill:#000022; -fx-background-radius:8;
                                          -fx-font-size:15; -fx-alignment:CENTER; -fx-padding:8 12;">
                            <font><Font name="Segoe UI" size="15.0" /></font>
                        </TextField>

                        <Label text="Đặt nhanh:"
                               style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" />

                        <!-- 3 nút đặt giá nhanh — chia đều nhau -->
                        <HBox alignment="CENTER" spacing="8">
                            <Button fx:id="quickBid1" onAction="#handleQuickBid1"
                                    text="+100k" prefWidth="80"
                                    style="-fx-background-color:rgba(110,231,183,0.12);
                                           -fx-text-fill:#6ee7b7;
                                           -fx-border-color:#6ee7b7; -fx-border-width:0.8;
                                           -fx-border-radius:6; -fx-background-radius:6;
                                           -fx-font-size:12; -fx-padding:6 0; -fx-cursor:hand;" />
                            <Button fx:id="quickBid2" onAction="#handleQuickBid2"
                                    text="+500k" prefWidth="80"
                                    style="-fx-background-color:rgba(110,231,183,0.12);
                                           -fx-text-fill:#6ee7b7;
                                           -fx-border-color:#6ee7b7; -fx-border-width:0.8;
                                           -fx-border-radius:6; -fx-background-radius:6;
                                           -fx-font-size:12; -fx-padding:6 0; -fx-cursor:hand;" />
                            <Button fx:id="quickBid3" onAction="#handleQuickBid3"
                                    text="+1M" prefWidth="80"
                                    style="-fx-background-color:rgba(110,231,183,0.12);
                                           -fx-text-fill:#6ee7b7;
                                           -fx-border-color:#6ee7b7; -fx-border-width:0.8;
                                           -fx-border-radius:6; -fx-background-radius:6;
                                           -fx-font-size:12; -fx-padding:6 0; -fx-cursor:hand;" />
                        </HBox>

                        <Label fx:id="errorLabel"
                               style="-fx-text-fill:#fca5a5; -fx-font-size:11;"
                               text="" wrapText="true" maxWidth="Infinity" />

                        <!-- Nút đặt giá — full width -->
                        <Button onAction="#handlePlaceBid" maxWidth="Infinity"
                                style="-fx-background-color:#770000; -fx-text-fill:white;
                                       -fx-font-size:14; -fx-font-weight:bold;
                                       -fx-background-radius:8; -fx-cursor:hand; -fx-padding:10 0;"
                                text="ĐẶT GIÁ NGAY">
                            <font><Font name="Segoe UI Bold" size="14.0" /></font>
                        </Button>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Số dư -->
                        <HBox alignment="CENTER" spacing="6"
                              style="-fx-background-color:rgba(255,255,255,0.06);
                                     -fx-background-radius:8; -fx-padding:8 14;">
                            <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" text="Số dư của bạn:" />
                            <Label fx:id="balanceLiveLabel2"
                                   style="-fx-text-fill:#6ee7b7; -fx-font-weight:bold; -fx-font-size:12;"
                                   text="0 ₫" />
                        </HBox>

                    </VBox>
                </VBox>

                <!-- ╔══════════════════════════════════════════╗
                     ║  CỘT PHẢI — Biểu đồ + Lịch sử đặt giá  ║
                     ║  (1/3 chiều rộng)                        ║
                     ╚══════════════════════════════════════════╝ -->
                <VBox spacing="10" HBox.hgrow="ALWAYS">

                    <!-- Card Biểu đồ -->
                    <VBox spacing="8"
                          style="-fx-background-color:#003333; -fx-background-radius:10;
                                 -fx-border-color:#6ee7b7; -fx-border-radius:10;
                                 -fx-border-width:1; -fx-padding:14;">
                        <Label text="BIỂU ĐỒ GIÁ THỜI GIAN THỰC"
                               style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" />

                        <LineChart fx:id="bidChart"
                                   prefHeight="190" maxWidth="Infinity" animated="true"
                                   style="-fx-background-color:transparent; -fx-padding:0;">
                            <xAxis>
                                <NumberAxis fx:id="xAxis"
                                            label="Lượt đặt" side="BOTTOM"
                                            forceZeroInRange="false" tickUnit="1"
                                            style="-fx-tick-label-fill:#c8f5e1;" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="yAxis"
                                            label="Giá" side="LEFT"
                                            forceZeroInRange="false"
                                            style="-fx-tick-label-fill:#c8f5e1;" />
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <!-- Card Lịch sử đặt giá -->
                    <VBox spacing="8" VBox.vgrow="ALWAYS"
                          style="-fx-background-color:#003333; -fx-background-radius:10;
                                 -fx-border-color:#6ee7b7; -fx-border-radius:10;
                                 -fx-border-width:1; -fx-padding:14;">
                        <Label text="LỊCH SỬ ĐẶT GIÁ"
                               style="-fx-text-fill:#c8f5e1; -fx-font-size:10; -fx-font-weight:bold;" />

                        <TableView fx:id="bidHistoryTable"
                                   style="-fx-background-color:#006633;"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <!-- 3 cột chia đều — dùng prefWidth bằng nhau -->
                                <TableColumn fx:id="colUsername" prefWidth="120" text="Người đặt" />
                                <TableColumn fx:id="colTime"     prefWidth="120" text="Thời gian" />
                                <TableColumn fx:id="colAmount"   prefWidth="120" text="Giá đặt (VND)" />
                            </columns>
                            <placeholder>
                                <Label style="-fx-text-fill:#c8f5e1; -fx-font-size:11;"
                                       text="Chưa có lượt đặt giá nào" />
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </HBox>

        </VBox>
    </children>
</AnchorPane>
