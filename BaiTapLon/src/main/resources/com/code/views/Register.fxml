<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.code.controllers.RegisterController">
    <children>

        <!-- Hình nền -->
        <ImageView fitHeight="500.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="false"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image><Image url="@../images/taotailkhoan.jpg" /></image>
        </ImageView>

        <!-- Form đăng ký — căn giữa màn hình -->
        <VBox alignment="CENTER"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <VBox maxWidth="360.0" spacing="14.0"
                      style="-fx-background-color: rgba(0,0,0,0.45);
                             -fx-background-radius: 16;
                             -fx-padding: 30 32 30 32;">

                    <!-- Tiêu đề -->
                    <Label text="Tạo tài khoản mới"
                           style="-fx-text-fill: white; -fx-font-weight: bold;">
                        <font><Font size="20.0" /></font>
                    </Label>

                    <!-- Thông báo vai trò mặc định -->
                    <HBox spacing="8.0" alignment="CENTER_LEFT"
                          style="-fx-background-color: rgba(110,231,183,0.18);
                                 -fx-background-radius: 8;
                                 -fx-padding: 8 12 8 12;">
                        <Label text="✅" style="-fx-font-size: 13;" />
                        <Label wrapText="true" maxWidth="290.0"
                               style="-fx-text-fill: #c8f5e1; -fx-font-size: 12;"
                               text="Tài khoản sẽ có đầy đủ quyền Người mua và Người bán ngay sau khi đăng ký." />
                    </HBox>

                    <!-- Tên đăng nhập -->
                    <VBox spacing="4.0">
                        <Label text="Tên đăng nhập"
                               style="-fx-text-fill: #e2e8f0; -fx-font-size: 13;" />
                        <TextField fx:id="usernameField" promptText="Tối thiểu 4 ký tự"
                                   style="-fx-background-color: #99D1D3;
                                          -fx-text-fill: #000080;
                                          -fx-prompt-text-fill: #4a7b9d;
                                          -fx-background-radius: 8;
                                          -fx-border-color: #404040;
                                          -fx-border-radius: 8;
                                          -fx-padding: 9;" />
                    </VBox>

                    <!-- Mật khẩu -->
                    <VBox spacing="4.0">
                        <Label text="Mật khẩu"
                               style="-fx-text-fill: #e2e8f0; -fx-font-size: 13;" />
                        <PasswordField fx:id="passwordField" promptText="Tối thiểu 6 ký tự"
                                       style="-fx-background-color: #99D1D3;
                                              -fx-text-fill: #000080;
                                              -fx-background-radius: 8;
                                              -fx-border-color: #404040;
                                              -fx-border-radius: 8;
                                              -fx-padding: 9;" />
                    </VBox>

                    <!-- Xác nhận mật khẩu -->
                    <VBox spacing="4.0">
                        <Label text="Xác nhận mật khẩu"
                               style="-fx-text-fill: #e2e8f0; -fx-font-size: 13;" />
                        <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu"
                                       style="-fx-background-color: #99D1D3;
                                              -fx-text-fill: #000080;
                                              -fx-background-radius: 8;
                                              -fx-border-color: #404040;
                                              -fx-border-radius: 8;
                                              -fx-padding: 9;" />
                    </VBox>

                    <!-- Thông báo lỗi -->
                    <Label fx:id="errorLabel" text="" wrapText="true" maxWidth="360.0"
                           style="-fx-text-fill: #ff4d4d; -fx-font-size: 12;" />

                    <!-- Nút đăng ký -->
                    <Button fx:id="registerButton" text="Đăng ký" maxWidth="Infinity"
                            style="-fx-background-color: #16a34a;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8;
                                   -fx-cursor: hand;
                                   -fx-padding: 10 0;">
                        <font><Font size="14.0" /></font>
                    </Button>

                    <!-- Link đăng nhập -->
                    <HBox alignment="CENTER" spacing="5.0">
                        <Label text="Đã có tài khoản?"
                               style="-fx-text-fill: #c8d6e5; -fx-font-size: 12;" />
                        <Label fx:id="linkLogin" text="Đăng nhập ngay"
                               style="-fx-text-fill: #6ee7b7;
                                      -fx-cursor: hand;
                                      -fx-underline: true;
                                      -fx-font-size: 12;" />
                    </HBox>

                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
