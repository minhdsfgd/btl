<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: #012b18;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.code.controllers.RegisterController">
    <children>
        <VBox maxWidth="350.0" spacing="10.0">
            <children>

                <VBox alignment="CENTER" spacing="2.0">
                    <VBox.margin>
                        <Insets bottom="15.0" top="20.0" />
                    </VBox.margin>
                    <children>
                        <Label text="AUCTION SYSTEM" textFill="#59ff69">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                        <Label text="TẠO TÀI KHOẢN" textFill="#cfcfcf">
                            <font><Font size="14.0" /></font>
                            <VBox.margin><Insets bottom="5.0" /></VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #cfcfcf;" text="Họ tên" />
                    <TextField fx:id="fullNameField"
                               style="-fx-background-color: #2a2a2a; -fx-text-fill: white;
                                      -fx-background-radius: 8; -fx-border-color: #404040;
                                      -fx-border-radius: 8; -fx-padding: 8;" />
                </VBox>

                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #cfcfcf;" text="Tên đăng nhập" />
                    <TextField fx:id="usernameField" promptText="user123"
                               style="-fx-background-color: #2a2a2a; -fx-text-fill: white;
                                      -fx-prompt-text-fill: #606060; -fx-background-radius: 8;
                                      -fx-border-color: #404040; -fx-border-radius: 8; -fx-padding: 8;" />
                </VBox>

                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #cfcfcf;" text="Mật khẩu" />
                    <PasswordField fx:id="passwordField"
                                   style="-fx-background-color: #2a2a2a; -fx-text-fill: white;
                                          -fx-background-radius: 8; -fx-border-color: #404040;
                                          -fx-border-radius: 8; -fx-padding: 8;" />
                </VBox>

                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #cfcfcf;" text="Xác nhận lại mật khẩu" />
                    <PasswordField fx:id="confirmPasswordField"
                                   style="-fx-background-color: #2a2a2a; -fx-text-fill: white;
                                          -fx-background-radius: 8; -fx-border-color: #404040;
                                          -fx-border-radius: 8; -fx-padding: 8;" />
                </VBox>

                <Label fx:id="errorLabel" maxWidth="350.0"
                       style="-fx-text-fill: #ff4d4d; -fx-font-size: 12;"
                       text="" wrapText="true" />

                <Button fx:id="registerButton" prefWidth="104.0"
                        style="-fx-background-color: #1e7e34; -fx-text-fill: white;
                               -fx-background-radius: 5; -fx-cursor: hand;"
                        text="Đăng ký">
                    <font><Font size="14.0" /></font>
                </Button>


                <HBox alignment="CENTER_LEFT" spacing="5.0">
                    <VBox.margin><Insets top="2.0" bottom="20.0" /></VBox.margin>
                    <Label style="-fx-text-fill: #aaaaaa;" text="Đã có tài khoản?" />
                    <Label fx:id="linkLogin"
                           style="-fx-text-fill: #0b8dff; -fx-cursor: hand;"
                           text="Đăng nhập" />
                </HBox>

            </children>
        </VBox>
    </children>
</VBox>