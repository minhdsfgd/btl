<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500" prefWidth="800"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.code.controllers.AuctionListController">

    <VBox prefHeight="500" prefWidth="800" style="-fx-background-color: #003b22;">

        <!-- Navbar -->
        <HBox alignment="CENTER_LEFT" style="-fx-background-color:#065f3b; -fx-padding:10;">
            <Label style="-fx-text-fill:white; -fx-font-size:16; -fx-font-weight:bold;"
                   text="DANH SÁCH PHIÊN" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="usernameLabel"
                   style="-fx-text-fill:#c8f5e1; -fx-padding: 0 10 0 0;"
                   text="username" />
            <Button fx:id="logoutButton"
                    style="-fx-background-color:#dc2626; -fx-text-fill:white;
                           -fx-font-weight:bold; -fx-background-radius:5; -fx-padding:5 15;"
                    text="Đăng xuất">
                <font><Font size="12.0" /></font>
            </Button>
        </HBox>

        <!-- Tìm kiếm -->
        <HBox spacing="10" style="-fx-padding:10;">
            <TextField fx:id="searchField"
                       promptText="Tìm kiếm theo tên sản phẩm..."
                       style="-fx-background-radius:8; -fx-padding:8;"
                       HBox.hgrow="ALWAYS" />
            <Button fx:id="searchButton"
                    style="-fx-background-color:#16a34a; -fx-text-fill:white; -fx-background-radius:8;"
                    text="🔍" />
        </HBox>

        <!-- Filter -->
        <HBox spacing="10" style="-fx-padding:0 10 10 10;">
            <Button fx:id="filterAllButton"
                    text="Tất cả" />
            <Button fx:id="filterActiveButton"
                    text="Đang diễn ra" />
            <Button fx:id="filterUpcomingButton"
                    text="Sắp mở" />
            <Button fx:id="filterEndedButton"
                    text="Kết thúc" />
        </HBox>

        <!-- Danh sách card -->
        <VBox fx:id="auctionListContainer" spacing="10" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="10" left="10" right="10" top="0" />
            </padding>
        </VBox>

    </VBox>

</AnchorPane>