<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="rootPane" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.code.controllers.AuctionListController"><!-- Hình nền -->
    <ImageView fx:id="backgroundImage" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <image>
            <Image url="@../images/screen.jpg"/>
        </image>
    </ImageView>

    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">

        <!-- ── Navbar ─────────────────────────────────────────────────── -->
        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color:#065f3b; -fx-padding:10;">

            <Label fx:id="navTitleLabel" style="-fx-text-fill:white; -fx-font-size:15; -fx-font-weight:bold;"
                   text="DANH SÁCH PHIÊN ĐẤU GIÁ">
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Toggle chế độ Người mua / Người bán -->
            <HBox alignment="CENTER" spacing="2"
                  style="-fx-background-color:rgba(255,255,255,0.15);                              -fx-background-radius:20; -fx-padding:3 4 3 4;">
                <Button fx:id="modeBuyerButton"
                        style="-fx-background-color:white; -fx-text-fill:#065f3b;                                    -fx-font-weight:bold; -fx-font-size:12;                                    -fx-background-radius:16; -fx-padding:4 12; -fx-cursor:hand;"
                        text="🛒 Người mua"/>
                <Button fx:id="modeSellerButton"
                        style="-fx-background-color:transparent;                                    -fx-text-fill:rgba(255,255,255,0.8); -fx-font-size:12;                                    -fx-background-radius:16; -fx-padding:4 12; -fx-cursor:hand;"
                        text="🏷 Người bán"/>
            </HBox>

            <!-- Số dư + Nút nạp tiền -->
            <HBox alignment="CENTER" spacing="6"
                  style="-fx-background-color:rgba(255,255,255,0.12);                              -fx-background-radius:10; -fx-padding:4 10 4 10;">
                <Label style="-fx-font-size:12;" text="💰"/>
                <Label fx:id="balanceLabel" style="-fx-text-fill:#6ee7b7; -fx-font-weight:bold; -fx-font-size:12;"
                       text="0 ₫">
                    <font>
                        <Font name="Segoe UI Bold" size="12.0"/>
                    </font>
                </Label>
                <Button fx:id="depositButton"
                        style="-fx-background-color:#0d7a3e; -fx-text-fill:white;                                    -fx-font-size:11; -fx-background-radius:6;                                    -fx-padding:3 8; -fx-cursor:hand;"
                        text="Nạp tiền"/>
            </HBox>

            <!-- Tên người dùng -->
            <Label fx:id="usernameLabel" style="-fx-text-fill:#c8f5e1; -fx-padding: 0 6 0 0;" text="username"/>

            <!-- Đăng xuất -->
            <Button fx:id="logoutButton"
                    style="-fx-background-color:#880000; -fx-text-fill:white;                                -fx-font-weight:bold; -fx-background-radius:5; -fx-padding:5 15;"
                    text="Đăng xuất">
                <font>
                    <Font name="Segoe UI" size="12.0"/>
                </font>
            </Button>
        </HBox>

        <!-- ── Tìm kiếm ───────────────────────────────────────────────── -->
        <HBox spacing="10" style="-fx-padding:10;">
            <TextField fx:id="searchField" prefHeight="35.0" promptText="Tìm kiếm theo tên sản phẩm..."
                       style="-fx-background-radius:8; -fx-padding:8;" HBox.hgrow="ALWAYS">
                <font>
                    <Font size="12.0"/>
                </font>
            </TextField>
            <Button fx:id="searchButton"
                    style="-fx-background-color:#16a34a; -fx-text-fill:white;                                -fx-background-radius:8; -fx-padding:8 14;"
                    text="🔍"/>
            <Button fx:id="refreshButton"
                    style="-fx-background-color:#065f3b; -fx-text-fill:#c8f5e1;                                -fx-background-radius:8; -fx-padding:8 12; -fx-cursor:hand;"
                    text="↺ Làm mới"/>
        </HBox>

        <!-- ── Bộ lọc trạng thái + danh mục ─────────────────────────── -->
        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding:0 10 8 10;">
            <!-- Lọc trạng thái -->
            <Button fx:id="filterAllButton"
                    style="-fx-background-color:#16a34a; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:8; -fx-padding:5 12; -fx-cursor:hand;"
                    text="Tất cả"/>
            <Button fx:id="filterActiveButton"
                    style="-fx-background-color:#065f3b; -fx-text-fill:#9fe6c8; -fx-background-radius:8; -fx-padding:5 12; -fx-cursor:hand;"
                    text="⏵ Đang diễn ra"/>
            <Button fx:id="filterUpcomingButton"
                    style="-fx-background-color:#065f3b; -fx-text-fill:#9fe6c8; -fx-background-radius:8; -fx-padding:5 12; -fx-cursor:hand;"
                    text="🕐 Sắp mở"/>
            <Button fx:id="filterEndedButton"
                    style="-fx-background-color:#065f3b; -fx-text-fill:#9fe6c8; -fx-background-radius:8; -fx-padding:5 12; -fx-cursor:hand;"
                    text="✓ Kết thúc"/>
            <Button fx:id="filterPendingPaymentButton"
                    style="-fx-background-color:#065f3b; -fx-text-fill:#9fe6c8; -fx-background-radius:8; -fx-padding:5 12; -fx-cursor:hand;"
                    text="⏳ Chờ thanh toán"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Lọc danh mục -->
            <Label text="Danh mục" style="-fx-text-fill: #006633; -fx-font-weight: bold;" />
            <ComboBox fx:id="categoryComboBox" prefWidth="130"
                      style="-fx-background-color:rgba(255,255,255,0.9);                                  -fx-background-radius:8; -fx-font-size:11;"/>
        </HBox>

        <!-- ── Số lượng kết quả ───────────────────────────────────────── -->
        <HBox style="-fx-padding:0 12 4 12;">
            <Label fx:id="resultCountLabel" style="-fx-text-fill:#9fe6c8; -fx-font-size:11;" text=""/>
        </HBox>

        <!-- ── Danh sách card ─────────────────────────────────────────── -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background:transparent; -fx-background-color:transparent;" vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS">
            <content>
                <FlowPane fx:id="auctionListContainer" hgap="12" style="-fx-background-color:transparent;" vgap="12">
                    <padding>
                        <Insets bottom="12" left="12" right="12" top="4"/>
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>

    </VBox>
</AnchorPane>
