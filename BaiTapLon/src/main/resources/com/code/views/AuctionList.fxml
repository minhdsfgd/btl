<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.code.controllers.AuctionListController">
    <children>

        <!-- Hình nền -->
        <ImageView fitHeight="500.0" fitWidth="800.0" pickOnBounds="true" preserveRatio="false"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image><Image url="@../images/screen.jpg" /></image>
        </ImageView>

        <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- ── Navbar ─────────────────────────────────────────────────── -->
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-background-color:#065f3b; -fx-padding:10;">

                <Label fx:id="navTitleLabel" text="DANH SÁCH PHIÊN ĐẤU GIÁ"
                       style="-fx-text-fill:white; -fx-font-size:15; -fx-font-weight:bold;">
                    <font><Font name="Segoe UI Bold" size="15.0" /></font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Toggle chế độ Người mua / Người bán -->
                <HBox alignment="CENTER" spacing="2"
                      style="-fx-background-color:rgba(255,255,255,0.15);
                             -fx-background-radius:20; -fx-padding:3 4 3 4;">
                    <Button fx:id="modeBuyerButton" text="🛒 Người mua"
                            style="-fx-background-color:white; -fx-text-fill:#065f3b;
                                   -fx-font-weight:bold; -fx-font-size:12;
                                   -fx-background-radius:16; -fx-padding:4 12; -fx-cursor:hand;" />
                    <Button fx:id="modeSellerButton" text="🏷 Người bán"
                            style="-fx-background-color:transparent;
                                   -fx-text-fill:rgba(255,255,255,0.8); -fx-font-size:12;
                                   -fx-background-radius:16; -fx-padding:4 12; -fx-cursor:hand;" />
                </HBox>

                <!-- Số dư + Nút nạp tiền -->
                <HBox alignment="CENTER" spacing="6"
                      style="-fx-background-color:rgba(255,255,255,0.12);
                             -fx-background-radius:10; -fx-padding:4 10 4 10;">
                    <Label text="💰" style="-fx-font-size:12;" />
                    <Label fx:id="balanceLabel" text="0 ₫"
                           style="-fx-text-fill:#6ee7b7; -fx-font-weight:bold; -fx-font-size:12;">
                        <font><Font name="Segoe UI Bold" size="12.0" /></font>
                    </Label>
                    <Button fx:id="depositButton" text="Nạp tiền"
                            style="-fx-background-color:#0d7a3e; -fx-text-fill:white;
                                   -fx-font-size:11; -fx-background-radius:6;
                                   -fx-padding:3 8; -fx-cursor:hand;" />
                </HBox>

                <!-- Tên người dùng -->
                <Label fx:id="usernameLabel" text="username"
                       style="-fx-text-fill:#c8f5e1; -fx-padding: 0 6 0 0;" />

                <!-- Đăng xuất -->
                <Button fx:id="logoutButton" text="Đăng xuất"
                        style="-fx-background-color:#880000; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-background-radius:5; -fx-padding:5 15;">
                    <font><Font name="Segoe UI" size="12.0" /></font>
                </Button>
            </HBox>

            <!-- ── Tìm kiếm ───────────────────────────────────────────────── -->
            <HBox spacing="10" style="-fx-padding:10;">
                <TextField fx:id="searchField" prefHeight="35.0"
                           promptText="Tìm kiếm theo tên sản phẩm..."
                           style="-fx-background-radius:8; -fx-padding:8;"
                           HBox.hgrow="ALWAYS">
                    <font><Font size="12.0" /></font>
                </TextField>
                <Button fx:id="searchButton" text="🔍"
                        style="-fx-background-color:#16a34a; -fx-text-fill:white;
                               -fx-background-radius:8; -fx-padding:8 14;" />
                <Button fx:id="refreshButton" text="↺ Làm mới"
                        style="-fx-background-color:#065f3b; -fx-text-fill:#c8f5e1;
                               -fx-background-radius:8; -fx-padding:8 12; -fx-cursor:hand;" />
            </HBox>

            <!-- ── Bộ lọc trạng thái + danh mục ─────────────────────────── -->
            <HBox spacing="8" style="-fx-padding:0 10 8 10;" alignment="CENTER_LEFT">
                <!-- Lọc trạng thái -->
                <Button fx:id="filterAllButton"      text="Tất cả"
                        style="-fx-background-color:#16a34a; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:8; -fx-padding:5 12; -fx-cursor:hand;" />
                <Button fx:id="filterActiveButton"   text="⏵ Đang diễn ra"
                        style="-fx-background-color:#065f3b; -fx-text-fill:#9fe6c8; -fx-background-radius:8; -fx-padding:5 12; -fx-cursor:hand;" />
                <Button fx:id="filterUpcomingButton" text="🕐 Sắp mở"
                        style="-fx-background-color:#065f3b; -fx-text-fill:#9fe6c8; -fx-background-radius:8; -fx-padding:5 12; -fx-cursor:hand;" />
                <Button fx:id="filterEndedButton"    text="✓ Kết thúc"
                        style="-fx-background-color:#065f3b; -fx-text-fill:#9fe6c8; -fx-background-radius:8; -fx-padding:5 12; -fx-cursor:hand;" />

                <Region HBox.hgrow="ALWAYS" />

                <!-- Lọc danh mục -->
                <Label text="Danh mục:"
                       style="-fx-text-fill:#c8f5e1; -fx-font-size:11;" />
                <ComboBox fx:id="categoryComboBox" prefWidth="130"
                          style="-fx-background-color:rgba(255,255,255,0.9);
                                 -fx-background-radius:8; -fx-font-size:11;" />
            </HBox>

            <!-- ── Số lượng kết quả ───────────────────────────────────────── -->
            <HBox style="-fx-padding:0 12 4 12;">
                <Label fx:id="resultCountLabel" text=""
                       style="-fx-text-fill:#9fe6c8; -fx-font-size:11;" />
            </HBox>

            <!-- ── Danh sách card ─────────────────────────────────────────── -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background:transparent; -fx-background-color:transparent;"
                        VBox.vgrow="ALWAYS">
                <content>
                    <FlowPane fx:id="auctionListContainer" hgap="12" vgap="12"
                              style="-fx-background-color:transparent;">
                        <padding>
                            <Insets bottom="12" left="12" right="12" top="4" />
                        </padding>
                    </FlowPane>
                </content>
            </ScrollPane>

        </VBox>
    </children>
</AnchorPane>
